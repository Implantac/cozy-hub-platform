# ── Supabase (obrigatório) ────────────────────────────────────────────────
# URL do projeto e chave publicável. A publishable key é pública por design:
# ela só permite o que as políticas RLS autorizarem.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="SEU-PROJETO"

# ── Servidor (nunca expor no client) ──────────────────────────────────────
# Chave de serviço: bypassa RLS. Usada apenas pelo dispatcher e pelo OAuth.
SUPABASE_SERVICE_ROLE_KEY=""
# openssl rand -base64 32
OAUTH_TOKEN_ENC_KEY=""
# Segredo exclusivo para POST /api/public/cron/* (>=32 caracteres aleatórios).
# Nunca reutilize a chave publishable/anon do Supabase como autenticação de cron.
CRON_SECRET=""

# ── OAuth das plataformas ─────────────────────────────────────────────────
META_APP_ID=""
META_APP_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# "true" habilita postagem direta no TikTok (exige aprovação da app).
TIKTOK_DIRECT_POST="false"

# ── IA (opcional) ─────────────────────────────────────────────────────────
# Sem esta chave o Brain opera em modo regras (Nível 1) — que é o padrão.
LOVABLE_API_KEY=""

# ── Publicação ────────────────────────────────────────────────────────────
# "simulate" faz o dispatcher fingir publicações (dev/demo). Nunca em produção.
VELT_PUBLISHER_MODE=""

# ── Feature flags ─────────────────────────────────────────────────────────
# Desligadas por padrão. Só "true" liga; qualquer outro valor falha fechado.
# Commerce Hub: fornecedores, dropshipping, marketplaces. Nada disso existe
# ainda — ver src/lib/features/flags.ts.
VITE_FLAG_COMMERCE=""

# ── App ───────────────────────────────────────────────────────────────────
APP_ORIGIN="http://localhost:8080"

# ── VELT Studio: roteiro local opcional (somente servidor) ──────────────
# "ollama" usa modelo próprio, sem cobrança por tokens de API; "lovable" é o padrão.
STUDIO_AI_PROVIDER=lovable
# Esta URL é resolvida pelo servidor, não pelo navegador. Não exponha Ollama à internet.
STUDIO_OLLAMA_URL=http://127.0.0.1:11434
STUDIO_OLLAMA_MODEL=

# ── Worker de vídeo local: protótipo no mesmo servidor ───────────────────
# Segredo privado idêntico no VELT e no worker; gere um aleatório (>=32 ASCII).
STUDIO_WORKER_SECRET=
STUDIO_WORKER_URL=http://127.0.0.1:8765
